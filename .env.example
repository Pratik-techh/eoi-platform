# =============================================================================
# EOI Platform — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
# From: https://app.supabase.com/project/_/settings/api
# Or from: npx supabase status (local development)

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# CRITICAL: Never prefix with NEXT_PUBLIC_ — must never reach browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI Provider (optional) ───────────────────────────────────────────────────
# If not set, the system falls back to the deterministic template explainer.
# Supported: openai, anthropic, google (set LLM_PROVIDER accordingly)

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Seed ─────────────────────────────────────────────────────────────────────
# Fixed RNG seed for deterministic data generation
SEED_RNG_SEED=42

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Email outbox (simulated) ─────────────────────────────────────────────────
# All emails are recorded in the DB email_outbox table, not actually sent.
# Set SIMULATE_EMAIL=true (default) for prototype.
SIMULATE_EMAIL=true
